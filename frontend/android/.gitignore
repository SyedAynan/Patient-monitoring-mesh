# Using Android gitignore template: https://github.com/github/gitignore/blob/HEAD/Android.gitignore

# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
#  Uncomment the following line in case you need and you don't have the release build type files in your app
# release/

# Gradle files
.gradle/
build/

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ
*.iml
.idea/workspace.xml
.idea/tasks.xml
.idea/gradle.xml
.idea/assetWizardSettings.xml
.idea/dictionaries
.idea/libraries
# Android Studio 3 in .gitignore file.
.idea/caches
.idea/modules.xml
# Comment next line if keeping position of elements in Navigation Editor is relevant for you
.idea/navEditor.xml

# Keystore files
# Uncomment the following lines if you do not want to check your keystore files in.
#*.jks
#*.keystore

# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild
.cxx/

# Google Services (e.g. APIs or Firebase)
# google-services.json

# Freeline
freeline.py
freeline/
freeline_project_description.json

# fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output
fastlane/readme.md

# Version control
vcs.xml

# lint
lint/intermediates/
lint/generated/
lint/outputs/
lint/tmp/
# lint/reports/

# Android Profiling
*.hprof

# Cordova plugins for Capacitor
# NOTE: the generated SOURCE files are committed intentionally — `cap copy` in
# CI does not regenerate this subproject, so a fresh checkout needs it for
# Gradle to resolve `include ':capacitor-cordova-android-plugins'`. We un-ignore
# only the source/config files; its build/ output stays ignored.
capacitor-cordova-android-plugins
!capacitor-cordova-android-plugins/
!capacitor-cordova-android-plugins/build.gradle
!capacitor-cordova-android-plugins/cordova.variables.gradle
!capacitor-cordova-android-plugins/src/
!capacitor-cordova-android-plugins/src/**

# Copied web assets — committed intentionally for the same reason: the CI
# release pipeline copies out/ in, but keeping the bundle tracked means a plain
# `gradlew assembleDebug` on a fresh clone also produces a working APK.
!app/src/main/assets/public
!app/src/main/assets/public/**

# Generated Config files — committed intentionally (CI writes these via a
# Node copy step, not the Capacitor CLI).
!app/src/main/assets/capacitor.config.json
!app/src/main/assets/capacitor.plugins.json
!app/src/main/res/xml/config.xml
