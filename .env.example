APP_ENV=development
LOG_LEVEL=INFO
DATA_DIR=.data

# SQLite persistence location for the backend (Phase 5).
# The database file is <APP_DATA_DIR>/app.db; the directory is created on start.
APP_DATA_DIR=.data

# Set to 1 to run the backend with in-memory stores only (tests, CI).
# REMPM_DISABLE_DB=0

# Reserved for later phases:
# DATABASE_URL=sqlite:///./.data/app.db
# MQTT_BROKER_URL=mqtt://localhost:1883
# DEVICE_CREDENTIAL_SECRET=replace-for-local-demo-only