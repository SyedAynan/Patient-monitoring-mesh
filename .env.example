APP_ENV=development
LOG_LEVEL=INFO
DATA_DIR=.data

# SQLite persistence location for the backend (Phase 5).
# The database file is <APP_DATA_DIR>/app.db; the directory is created on start.
APP_DATA_DIR=.data

# Set to 1 to run the backend with in-memory stores only (tests, CI).
# REMPM_DISABLE_DB=0

# --- Phase 7: security ---
# Dashboard/backend operator auth: "lab" (default, no login — local demo only)
# or "token" (mutations require the X-Operator-Token header).
BACKEND_AUTH_MODE=lab

# Required when BACKEND_AUTH_MODE=token. Generate one locally, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Never commit the real value; this file is a template.
# OPERATOR_TOKEN=

# Set to 1 to run the simulated mesh with device authentication: every node
# signs its frames (HMAC-SHA256) and the gateway verifies before parsing.
# MESH_AUTH=0

# Reserved for later phases:
# DATABASE_URL=sqlite:///./.data/app.db
# MQTT_BROKER_URL=mqtt://localhost:1883
# DEVICE_CREDENTIAL_SECRET=replace-for-local-demo-only