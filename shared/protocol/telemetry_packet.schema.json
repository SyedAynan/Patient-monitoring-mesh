{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rempm:telemetry-packet:v1",
  "title": "TelemetryPacketV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "packet_type", "device_id", "patient_id", "sequence_number", "captured_at_ms", "priority", "signal_quality", "measurements"],
  "properties": {
    "schema_version": { "const": 1 },
    "packet_type": { "const": "telemetry" },
    "device_id": { "type": "string", "pattern": "^node-[a-z0-9-]{1,31}$" },
    "patient_id": { "type": "string", "pattern": "^patient-[a-z0-9-]{1,31}$" },
    "sequence_number": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "captured_at_ms": { "type": "integer", "minimum": 0 },
    "priority": { "enum": ["routine", "critical"] },
    "signal_quality": { "type": "number", "minimum": 0, "maximum": 1 },
    "measurements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["heart_rate_bpm", "spo2_percent", "temperature_c"],
      "properties": {
        "heart_rate_bpm": { "type": "number", "minimum": 0, "maximum": 300 },
        "spo2_percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "temperature_c": { "type": "number", "minimum": 0, "maximum": 60 }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "score"],
      "properties": {
        "level": { "enum": ["normal", "attention", "critical"] },
        "score": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    }
  }
}
